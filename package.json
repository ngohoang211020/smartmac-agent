{
  "name": "smartmac-agent",
  "version": "1.0.0",
  "description": "Open-source cross-platform local laptop admin dashboard & AI housework agent (CPU, RAM, GPU, Files, Wi-Fi, Network, Apps, Gmail, Facebook)",
  "keywords": [
    "system-monitor",
    "macos",
    "linux",
    "windows",
    "dashboard",
    "ai-agent",
    "local-agent",
    "hardware-monitor"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "smartmac": "./bin/cli.mjs",
    "smartmac-agent": "./bin/cli.mjs",
    "housework-agent": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node ./bin/cli.mjs",
    "prepublishOnly": "vite build"
  },
  "dependencies": {
    "@google/genai": "latest",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "imapflow": "^1.0.171",
    "lucide-react": "^0.475.0",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "systeminformation": "^5.25.11",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
